{
  "version": 2,
  "functions": {
    "dist/index.cjs": { "runtime": "vercel-node@latest" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/dist/index.cjs" },
    { "source": "/", "destination": "/dist/public/index.html" },
    { "source": "/(.*)", "destination": "/dist/public/$1" }
  ]
}
